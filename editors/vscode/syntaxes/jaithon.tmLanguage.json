{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Jaithon",
  "scopeName": "source.jaithon",
  "fileTypes": ["jai"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#calls" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.jaithon",
          "match": "#:.*$",
          "captures": { "0": { "name": "comment.block.documentation.jaithon" } }
        },
        {
          "name": "comment.block.jaithon",
          "begin": "#\\*",
          "end": "\\*#",
          "patterns": [{ "include": "#comments" }]
        },
        { "name": "comment.line.number-sign.jaithon", "match": "#.*$" }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.jaithon",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.triple.jaithon",
          "begin": "'''",
          "end": "'''",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.interpolated.jaithon",
          "begin": "\\bf\"",
          "end": "\"",
          "patterns": [
            { "include": "#escapes" },
            {
              "name": "meta.embedded.jaithon",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.jaithon" } },
              "endCaptures": { "0": { "name": "punctuation.section.embedded.end.jaithon" } },
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.quoted.other.raw.jaithon",
          "begin": "\\br\"",
          "end": "\""
        },
        {
          "name": "string.quoted.double.jaithon",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.jaithon",
          "begin": "'(?![A-Za-z_][A-Za-z0-9_]*(?![A-Za-z0-9_']))",
          "end": "'",
          "patterns": [{ "include": "#escapes" }]
        },
        { "name": "entity.name.label.jaithon", "match": "'[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },

    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.jaithon",
          "match": "\\\\(?:[ntr0\\\\\"']|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\})" },
        { "name": "invalid.illegal.escape.jaithon", "match": "\\\\." }
      ]
    },

    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.jaithon", "match": "\\b0[xX][0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.octal.jaithon", "match": "\\b0[oO][0-7_]+\\b" },
        { "name": "constant.numeric.binary.jaithon", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.float.jaithon",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9_]+)\\b" },
        { "name": "constant.numeric.float.jaithon",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b" },
        { "name": "constant.numeric.integer.jaithon", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.jaithon" },
            "2": { "name": "entity.name.function.jaithon" }
          }
        },
        {
          "match": "\\b(class|trait|enum|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.class.jaithon" },
            "2": { "name": "entity.name.type.jaithon" }
          }
        },
        {
          "match": "\\b(extends)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.jaithon" },
            "2": { "name": "entity.other.inherited-class.jaithon" }
          }
        },
        {
          "match": "\\b(import|from)\\s+((?:\\.)*[A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.import.jaithon" },
            "2": { "name": "entity.name.namespace.jaithon" }
          }
        },
        {
          "match": "\\b(let|var|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.jaithon" },
            "2": { "name": "variable.other.declaration.jaithon" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        { "name": "keyword.control.conditional.jaithon",
          "match": "\\b(if|elif|else|match|case)\\b" },
        { "name": "keyword.control.loop.jaithon",
          "match": "\\b(while|for|loop|in|break|continue)\\b" },
        { "name": "keyword.control.flow.jaithon",
          "match": "\\b(return|yield|throw|defer)\\b" },
        { "name": "keyword.control.exception.jaithon",
          "match": "\\b(try|catch|finally)\\b" },
        { "name": "keyword.control.import.jaithon",
          "match": "\\b(import|from|as|export|module)\\b" },
        { "name": "storage.modifier.jaithon",
          "match": "\\b(pub|prot|static|mut|impl)\\b" },
        { "name": "storage.type.jaithon",
          "match": "\\b(fn|let|var|const|class|trait|enum|type)\\b" },
        { "name": "keyword.other.jaithon", "match": "\\b(assert|get|set|where|operator)\\b" },
        { "name": "variable.language.jaithon", "match": "\\b(self|super)\\b" },
        { "name": "keyword.operator.logical.jaithon", "match": "\\b(and|or|not|is|in)\\b" }
      ]
    },

    "types": {
      "patterns": [
        { "name": "support.type.primitive.jaithon",
          "match": "\\b(int|float|bool|str|bytes|any|void|never|list|dict|set|tuple|range|fn)\\b(?=\\s*[\\[\\)\\],:=?|>\\n])" },
        { "name": "support.class.error.jaithon",
          "match": "\\b(Error|AssertionError|ArithmeticError|DivisionByZeroError|OverflowError|LookupError|IndexError|KeyError|NameError|TypeError|ValueError|ParseError|AttributeError|IOError|FileNotFoundError|PermissionError|OSError|RuntimeError|RecursionError|StopIteration|ImportError)\\b" },
        { "name": "entity.name.type.jaithon", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },

    "constants": {
      "patterns": [
        { "name": "constant.language.jaithon", "match": "\\b(true|false|null)\\b" },
        { "name": "variable.other.constant.jaithon", "match": "\\b[A-Z][A-Z0-9_]{2,}\\b" }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.jaithon",
          "match": "(\\*\\*=|//=|<<=|>>=|[+\\-*/%&|^]=|=)" },
        { "name": "keyword.operator.comparison.jaithon", "match": "(==|!=|<=|>=|<|>)" },
        { "name": "keyword.operator.arithmetic.jaithon",
          "match": "(\\*\\*|//|[+\\-*/%@]%?)" },
        { "name": "keyword.operator.bitwise.jaithon", "match": "(<<|>>|[&|^~])" },
        { "name": "keyword.operator.range.jaithon", "match": "(\\.\\.=|\\.\\.)" },
        { "name": "keyword.operator.other.jaithon", "match": "(\\?\\?|\\?\\.|->|=>|\\?|\\.\\.\\.)" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.jaithon", "match": "[,:;]" },
        { "name": "punctuation.accessor.jaithon", "match": "\\." },
        { "name": "punctuation.section.brackets.jaithon", "match": "[\\[\\]{}()]" }
      ]
    },

    "calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.jaithon" } }
        },
        {
          "match": "\\b(__prim__)\\b",
          "captures": { "1": { "name": "support.function.builtin.jaithon" } }
        },
        {
          "name": "support.function.builtin.jaithon",
          "match": "\\b(print|input|len|range|type|repr|str|int|float|bool|id|hash|abs|min|max|sum|sorted|reversed|enumerate|zip|map|filter|any|all|chr|ord|isinstance|callable|dir|exit)\\b(?=\\s*\\()"
        }
      ]
    },

    "identifiers": {
      "patterns": [
        { "name": "variable.other.jaithon", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    }
  }
}
