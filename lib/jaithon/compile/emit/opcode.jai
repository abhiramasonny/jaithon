#: The instruction set: the opcode enum, in wire order, and its property table.

#: The opcode set of `src/vm/bytecode/chunk.h`, in wire order.
pub enum Op {
    Nop,
    Const,
    Null,
    True,
    False,
    Int,
    Pop,
    PopN,
    Dup,
    Dup2,
    Swap,
    Rot3,
    GetLocal,
    SetLocal,
    GetUpvalue,
    SetUpvalue,
    CloseUpvalue,
    GetGlobal,
    SetGlobal,
    DefGlobal,
    GetModule,
    Add,
    Sub,
    Mul,
    Div,
    FloorDiv,
    Mod,
    Pow,
    AddWrap,
    SubWrap,
    MulWrap,
    Neg,
    Pos,
    BAnd,
    BOr,
    BXor,
    Shl,
    Shr,
    BNot,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    Is,
    IsNot,
    In,
    NotIn,
    Not,
    Concat,
    AddIntConst,
    IncLocal,
    CmpLocalConstLt,
    GetLocal2,
    AddLocals,
    Jump,
    JumpIfFalse,
    JumpIfTrue,
    JumpIfFalseKeep,
    JumpIfTrueKeep,
    JumpIfNull,
    Loop,
    GetIter,
    ForIter,
    Call,
    CallKw,
    CallSpread,
    Invoke,
    SuperInvoke,
    TailCall,
    Return,
    ReturnNull,
    Closure,
    BuildList,
    BuildDict,
    BuildSet,
    BuildTuple,
    BuildRange,
    ListAppend,
    DictInsert,
    SetAdd,
    GetIndex,
    SetIndex,
    GetSlice,
    SetSlice,
    Unpack,
    Class,
    Inherit,
    ImplTrait,
    Method,
    FieldDef,
    GetField,
    SetField,
    GetSuper,
    New,
    EnumNew,
    EnumTag,
    EnumField,
    IsInstance,
    Throw,
    Reraise,
    PushHandler,
    PopHandler,
    PushFinally,
    EndFinally,
    PushDefer,
    RunDefers,
    MatchExc,
    GetExc,
    MatchConst,
    MatchRange,
    MatchType,
    MatchSeq,
    MatchFields,
    Bind,
    Import,
    ImportFrom,
    Export,
    AssertFail,
    TypeGuard,
    Halt,
    GetFieldLocal,
    ForIterBind,
    JumpIfCmpFalse,
    Format,
    JumpIfCmpLocalK,
    ToFloat,
    ModIntConst,
    AddBind,
    SubBind,
    MulBind,
    ElemKind,
    GetIterItems,
    ForIterPair,
    IterRange,
    ForRangeBind,
    SubIntConst,
    PopReturnNull,
    MatchConstPop,
    SwapPop,
    MatchTypePop,
    MatchRangePop,
    MatchSeqPop,
    MulIntConst,
}

#: Stack effect of an instruction whose net change depends on its operands.
#: `SE_VAR` in `src/vm/bytecode/chunk.c`; the emitter adjusts those by hand.
pub const STACK_EFFECT_VARIABLE: int = -1000000

class OpSpec {
    pub let op: Op
    pub let name: str
    pub let operands: int
    pub let effect: int

    pub fn init(self, op: Op, name: str, operands: int, effect: int) {
        self.op = op
        self.name = name
        self.operands = operands
        self.effect = effect
    }
}

let _OPS: list[OpSpec] = [
