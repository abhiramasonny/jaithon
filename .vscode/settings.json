{
    "files.associations": {
        "*.jai": "jaithon",
        "*.h": "c"
    },
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.includePath": ["${workspaceFolder}/src"],
    "C_Cpp.default.defines": ["JAI_DEBUG"],
    "editor.rulers": [100],
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "[jaithon]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "search.exclude": {
        "build/**": true,
        "legacy_src/**": true,
        "**/__jaicache__/**": true
    }
}
