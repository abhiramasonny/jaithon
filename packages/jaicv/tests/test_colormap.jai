#: Colour maps, level by level, against OpenCV 5.0.0.
#:
#: `EXPECTED` is what OpenCV returns for a 0..255 ramp under each of its
#: twenty-two maps, recorded straight from `cv2` into this file. It is a
#: second, independent recording of the same thing `colormap_data.jai` holds,
#: and that is the point: checking the tables jaicv applies against the tables
#: jaicv ships would only prove the file is self-consistent, so what is
#: written out below came from OpenCV rather than from the package.
#:
#: The bar here is equality, not closeness. `apply_color_map` reads OpenCV's
#: own tables, so there is nothing left to round and no level is allowed to
#: differ by one.
from std.test import assert_contains, assert_eq, assert_throws
from jaicv.core.mat import Mat
from jaicv.core.types import CV_32F, CV_8U, CV_MAKETYPE
from jaicv.imgproc.misc import apply_color_map
from jaicv.imgproc.misc import COLORMAP_AUTUMN, COLORMAP_BONE, COLORMAP_CIVIDIS, COLORMAP_COOL
from jaicv.imgproc.misc import COLORMAP_DEEPGREEN, COLORMAP_HOT, COLORMAP_HSV, COLORMAP_INFERNO
from jaicv.imgproc.misc import COLORMAP_JET, COLORMAP_MAGMA, COLORMAP_OCEAN, COLORMAP_PARULA
from jaicv.imgproc.misc import COLORMAP_PINK, COLORMAP_PLASMA, COLORMAP_RAINBOW, COLORMAP_SPRING
from jaicv.imgproc.misc import COLORMAP_SUMMER, COLORMAP_TURBO, COLORMAP_TWILIGHT
from jaicv.imgproc.misc import COLORMAP_TWILIGHT_SHIFTED, COLORMAP_VIRIDIS, COLORMAP_WINTER

