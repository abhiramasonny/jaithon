#: A 3 by 4 image whose every pixel is a different level, and what OpenCV
#: makes of it under Viridis. A map applied per row, or once for the whole
#: image, would still pass a ramp; this is what catches it.
let GRID = [[0, 17, 200, 255], [128, 3, 64, 91], [255, 254, 1, 0]]

let GRID_EXPECTED = [
    84,
    1,
    68,
    108,
    26,
    72,
    87,
    207,
    112,
    37,
    231,
    253,
    140,
    145,
    33,
    89,
    5,
    69,
    139,
    82,
    59,
    142,
    110,
    46,
    37,
    231,
    253,
    35,
    231,
    251,
    86,
    2,
    68,
    84,
    1,
    68,
]

fn ramp() -> Mat {
    var levels: list[float] = []
    for level in 0..LEVELS { levels.push(float(level)) }
    return Mat.from_list(1, LEVELS, CV_MAKETYPE(CV_8U, 1), levels)
}

fn test_map_ids_are_opencvs() -> void {
    assert_eq(MAP_IDS.len(), OPENCV_IDS.len(), "one id per map")
    for index in 0..MAP_IDS.len() {
        assert_eq(
            MAP_IDS[index],
            OPENCV_IDS[index],
            f"COLORMAP_{MAP_NAMES[index]} is not the number OpenCV gives it"
        )
    }
}

fn test_every_map_matches_opencv_on_every_level() -> void {
    let src = ramp()
    for index in 0..MAP_IDS.len() {
        let out = apply_color_map(src, MAP_IDS[index])
        assert_eq(out.rows, 1, f"{MAP_NAMES[index]} changed the row count")
        assert_eq(out.cols, LEVELS, f"{MAP_NAMES[index]} changed the column count")
        assert_eq(out.channels(), 3, f"{MAP_NAMES[index]} did not come back as colour")
        let values = out.to_list()
        let base = index * LEVELS * 3
        var wrong = 0
        var first_at = -1
        var worst = 0
        for level in 0..LEVELS {
            var same = true
            for channel in 0..3 {
                let got = int(values[level * 3 + channel])
                let want = EXPECTED[base + level * 3 + channel]
                let gap = abs(got - want)
                if gap > worst { worst = gap }
                if gap != 0 { same = false }
            }
            if not same {
                wrong += 1
                if first_at < 0 { first_at = level }
            }
        }
        assert_eq(
            wrong,
            0,
            f"{MAP_NAMES[index]} differs from OpenCV on {wrong} of {LEVELS} levels, first at {first_at}, by up to {worst}"
        )
    }
}

fn test_two_dimensional_image_maps_each_pixel() -> void {
    var flat: list[float] = []
    for row in GRID {
        for level in row { flat.push(float(level)) }
    }
    let src = Mat.from_list(GRID.len(), GRID[0].len(), CV_MAKETYPE(CV_8U, 1), flat)
    let out = apply_color_map(src, COLORMAP_VIRIDIS)
    assert_eq(out.rows, GRID.len(), "the row count has to survive")
    assert_eq(out.cols, GRID[0].len(), "the column count has to survive")
    assert_eq(out.channels(), 3, "the result has to be colour")
    let values = out.to_list()
    for y in 0..GRID.len() {
        for x in 0..GRID[0].len() {
            for channel in 0..3 {
                let at = (y * GRID[0].len() + x) * 3 + channel
                assert_eq(
                    int(values[at]),
                    GRID_EXPECTED[at],
                    f"pixel ({y}, {x}) channel {channel} came out wrong"
                )
            }
        }
    }
}

fn test_a_level_maps_the_same_way_wherever_it_sits() -> void {
    #: The ramp and the grid share levels, and a lookup that reads anything of
    #: the pixel but its value would have them disagree.
    let ramped = apply_color_map(ramp(), COLORMAP_VIRIDIS).to_list()
    var flat: list[float] = []
    for row in GRID {
        for level in row { flat.push(float(level)) }
    }
    let src = Mat.from_list(GRID.len(), GRID[0].len(), CV_MAKETYPE(CV_8U, 1), flat)
    let gridded = apply_color_map(src, COLORMAP_VIRIDIS).to_list()
    for y in 0..GRID.len() {
        for x in 0..GRID[0].len() {
            let level = GRID[y][x]
            for channel in 0..3 {
                assert_eq(
                    int(gridded[(y * GRID[0].len() + x) * 3 + channel]),
                    int(ramped[level * 3 + channel]),
                    f"level {level} came out differently at ({y}, {x})"
                )
            }
        }
    }
}

fn test_values_outside_the_table_clamp() -> void {
    #: OpenCV only takes 8-bit input, so it has nothing to say here. Clamping
    #: is jaicv's own, and it has to land on the first and last entries.
    let wild = Mat.from_list(1, 4, CV_MAKETYPE(CV_32F, 1), [-40.0, 0.0, 255.0, 900.0])
    let values = apply_color_map(wild, COLORMAP_TURBO).to_list()
    let base = COLORMAP_TURBO * LEVELS * 3
    for channel in 0..3 {
        assert_eq(
            int(values[channel]),
            EXPECTED[base + channel],
            "a value below zero has to map as zero"
        )
        assert_eq(int(values[3 + channel]), EXPECTED[base + channel], "zero has to map as zero")
        assert_eq(
            int(values[6 + channel]),
            EXPECTED[base + 255 * 3 + channel],
            "255 has to map as 255"
        )
        assert_eq(
            int(values[9 + channel]),
            EXPECTED[base + 255 * 3 + channel],
            "a value above 255 has to map as 255"
        )
    }
}

fn test_three_channel_input_is_mapped_through_grey() -> void {
    #: OpenCV takes a colour image too, converting it to grey and mapping
    #: that. The expected triple is what `cv2.applyColorMap` returns for a
    #: uniform BGR (10, 200, 30) image under `JET`.
    var values: list[float] = []
    for _pixel in 0..16 {
        values.push(10.0)
        values.push(200.0)
        values.push(30.0)
    }
    let colour = Mat.from_list(4, 4, CV_MAKETYPE(CV_8U, 3), values)
    colour.flush()
    let mapped = apply_color_map(colour, COLORMAP_JET)
    assert_eq(mapped.rows, 4, "the mapped image keeps its height")
    assert_eq(mapped.cols, 4, "the mapped image keeps its width")
    let out = mapped.values()
    for pixel in 0..16 {
        assert_eq(int(out[pixel * 3]), 126, "blue")
        assert_eq(int(out[pixel * 3 + 1]), 255, "green")
        assert_eq(int(out[pixel * 3 + 2]), 130, "red")
    }
}

fn test_a_channel_count_no_map_takes_throws() -> void {
    #: One and three are what OpenCV accepts; anything else has no meaning as
    #: a level to look up.
    let four = Mat.zeros(4, 4, CV_MAKETYPE(CV_8U, 4))
    let error = assert_throws(ValueError, || apply_color_map(four, COLORMAP_JET))
    assert_contains(error.message, "4")
}

fn test_unknown_id_throws() -> void {
    let src = ramp()
    #: One past the last map and one before the first, and the message has to
    #: name the id so the caller can see what it asked for.
    let above = assert_throws(ValueError, || apply_color_map(src, MAP_IDS.len()))
    assert_contains(above.message, f"{MAP_IDS.len()}")
    let below = assert_throws(ValueError, || apply_color_map(src, -1))
    assert_contains(below.message, "-1")
}
