#: Indexed by the `FONT_HERSHEY_*` face numbers.
pub fn face_glyphs(face: int) -> list[str] {
    let tables = [FUTURAL, FUTURAL, FUTURAM, ROWMAND, ROWMANT, ROWMANS, SCRIPTS, SCRIPTC]
    if face < 0 or face >= tables.len() { return tables[0] }
    return tables[face]
}
