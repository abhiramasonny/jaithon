# Build output
/jaithon
/jaithon-dbg
/build/
*.o
*.d
*.dSYM/

# Experiment builds and the binaries they leave behind. `make` writes /build
# and /jaithon; anything with a suffix came from a one-off comparison and is
# not worth keeping.
/build-*/
/jaithon-*
!/jaithon.workspace.json

# Datasets live in ~/Developer/datasets and are symlinked back in, so this has
# to be a bare name: a trailing slash matches directories only and would let
# the symlink itself show up as untracked.
/data

# Benchmark and example output
*.ppm
/tests/bench/*.local.json
/digit_mistakes.png
/motion_trails.png
/plot.png
/plot.svg

# Bytecode cache
__jaicache__/
*.jaic

# Generated and vendored documentation. The hand-written parts of docs/ --
# notes, the roadmap, the probe write-ups -- are tracked; only what a tool
# produced is not.
/docs/api/
/docs/superpowers/

# Working notes
spec/

# JAI_JIT_DUMP artefacts
jit_*.bin
jit_*.bin.hex

# Scratch directories agents and probes leave behind
/.scratch/
/tmpclear/
/.claude/worktrees/

# Editor and OS noise
.DS_Store
*.swp
.vscode/ipch/
compile_commands.json
.cache/
__pycache__/

# Generated documentation. Kept on disk, deliberately never committed: these are
# per-function notes and a working handoff, not part of the project's story, and
# the repository should not carry them.
/docs/notes/
/docs/RESUME.md
/docs/repro/
