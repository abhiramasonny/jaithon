# Non-static functions in src/ that nothing outside their own .c
# reaches, and prototypes nothing defines. `file-local` wants
# `static`; `dead` wants deleting. Checked by
# scripts/gate/dead_code_check.py, which explains what this is for.
# The path is for a reader; only the verdict and the name are checked.
# Regenerate with: scripts/gate/dead_code_check.py --write

file-local jaiCliDispatch              src/cli/main.c
file-local jaiDiagCodeIsWarning        src/common/diag.c
file-local jaiSourceLineText           src/common/diag.c
file-local jaiMethodTablesInit         src/runtime/builtins/builtins.c
file-local jaiFormatValue              src/runtime/builtins/text/builtins_format.c
file-local jaiFrontEndCall0            src/runtime/modules/frontend.c
file-local jaiFrontEndField            src/runtime/modules/frontend.c
file-local jaiGCMarkArray              src/vm/gc.c
file-local emitDescriptorFull          src/vm/jit/jit_call_desc.c
file-local emitGlobalsGuard            src/vm/jit/jit_global.c
file-local emitVersionBump             src/vm/jit/jit_global.c
file-local globalIsSelf                src/vm/jit/jit_global.c
file-local globalNamespace             src/vm/jit/jit_global.c
file-local globalSlot                  src/vm/jit/jit_global.c
file-local jaiStringChar               src/vm/object/object_string.c
file-local enumMember                  src/vm/vm_class.c
file-local jaiVMPrintStack             src/vm/vm_lifecycle.c
file-local jaiVMResetStack             src/vm/vm_lifecycle.c
